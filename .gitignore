# Test / content PDFs — the plugin ships no PDFs; drop your own in to test.
*.pdf
# ...but the committed test fixture is intentionally kept.
!tests/fixtures/*.pdf

# One-time library vendoring scratch (see SETUP.md) and any npm output.
.tmp/
node_modules/
package-lock.json

# Composer (PHP test) dependencies
/vendor/
composer.lock

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
*.log

# Built plugin package(s) — generated by `npm run build:zip`, never committed.
*.zip
